---
permalink: /apps.json
layout: null
---
{%- assign source = site.data.apps -%}
{
  "name": {{ source.name | jsonify }},
  "identifier": {{ source.identifier | jsonify }},
  "apps": [
{%- for app in source.apps -%}
{%- assign is_beta = app.beta -%}
{%- assign rows = "" | split: "," -%}
{%- for release in site.github.releases -%}
  {%- if release.draft -%}{%- continue -%}{%- endif -%}
  {%- assign prefix = release.tag_name | slice: 0, 10 -%}
  {%- if is_beta -%}
    {%- unless release.prerelease and prefix == "ios-beta-v" -%}{%- continue -%}{%- endunless -%}
    {%- assign version = release.tag_name | remove_first: "ios-beta-v" -%}
    {%- assign ipa_name = "OneDrop-Beta-" | append: version | append: ".ipa" -%}
  {%- else -%}
    {%- if release.prerelease or prefix == "ios-beta-v" -%}{%- continue -%}{%- endif -%}
    {%- assign version = release.tag_name | remove_first: "v" -%}
    {%- assign ipa_name = "OneDrop-" | append: version | append: ".ipa" -%}
  {%- endif -%}
  {%- assign ipa = release.assets | where: "name", ipa_name | first -%}
  {%- unless ipa.state == "uploaded" and ipa.size > 0 -%}{%- continue -%}{%- endunless -%}

  {%- comment -%}Sort numeric iOS version components so 1.10 precedes 1.9, including backfilled releases.{%- endcomment -%}
  {%- assign parts = version | split: "." -%}
  {%- capture order -%}
    {%- for part in parts -%}{{ part | prepend: "0000000000" | slice: -10, 10 }}.{%- endfor -%}
  {%- endcapture -%}
  {%- capture row -%}
    {{ order }}|{"version":{{ version | jsonify }},{% if is_beta %}"buildNumber":{{ version | jsonify }},{% endif %}"date":{{ release.published_at | date_to_xmlschema | jsonify }},"size":{{ ipa.size | jsonify }},"downloadURL":{{ ipa.browser_download_url | jsonify }}}
  {%- endcapture -%}
  {%- assign rows = rows | push: row -%}
{%- endfor -%}
{%- if is_beta and rows.size == 0 -%}{%- continue -%}{%- endif -%}
{%- unless forloop.first -%},{%- endunless -%}
  {
    {% for field in app -%}
      {%- unless field[0] == "versions" -%}
        {{ field[0] | jsonify }}: {{ field[1] | jsonify }},
      {% endunless -%}
    {%- endfor -%}
    "versions": [
      {%- assign rows = rows | sort | reverse -%}
      {%- for row in rows -%}
        {{ row | split: "|" | last }}{% unless forloop.last %},{% endunless %}
      {%- else -%}
        {% unless site.github.releases %}{{ app.versions.first | jsonify }}{% endunless %}
      {%- endfor -%}
    ]
  }
{%- endfor -%}
  ]
}
